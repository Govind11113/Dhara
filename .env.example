# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
#   cp .env.example .env
#   cd scripts && npm run provision && npm run seed && npm run deploy

# Safe to expose: shipped in the Flutter app by design.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6aa42571001d94653e55

# SERVER SECRET. Used only by provisioning scripts and Appwrite Functions.
# Must NEVER appear in Dart code, an APK, the admin site, or a commit.
# Generate at: Console -> Overview -> View API keys -> Create key
APPWRITE_API_KEY=

# SERVER SECRET. Used only by the `api` Appwrite Function for photo verification
# (OpenCode, model step-5-preview-free). Set as a Function variable by
# `npm run deploy`; never in Dart or the admin site.
# Get one at https://opencode.ai/auth
OPENCODE_API_KEY=

# SERVER SECRET. Optional: OpenRouter, used by the vision benchmark and (if you
# pick it) by the `api` function. Never in Dart or the admin site.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
